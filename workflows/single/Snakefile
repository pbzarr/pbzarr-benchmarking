# Part 1: time creating one depth track from one alignment file (CRAM or BAM),
# for PBZ, mosdepth (D4), d4tools create (D4) and Megadepth (BigWig), at several
# thread counts. Then check where the tools' depths agree, and time the two scans
# of the cohort benchmark (full scan, region scan) on each tool's output. Run it
# with part1.sbatch.
#
# Each run is one timed command. Runs go one at a time (--resources bench=1).
# Data goes under the working directory (the job's local $TMPDIR) and is deleted
# after each run. Only the one-row result files go to the results folder.

import csv
import os
from itertools import islice
from pathlib import Path

# Paths in the config file are relative to the repo root (the parent of config/).
ROOT = Path(workflow.basedir).resolve().parents[1]


def from_root(path):
    path = Path(path).expanduser()
    return str(path if path.is_absolute() else ROOT / path)


MANIFEST = from_root(config["manifest"])
# Path templates with {sample} for each sample's alignment file and its index.
ALIGNMENT = from_root(config["alignment"])
INDEX = from_root(config["index"])
# BAM input needs no reference: `reference: null`, and the tools get no reference option.
REFERENCE = from_root(config["reference"]) if config["reference"] else None
PBZ = from_root(config["pbz"])
CODECS = from_root(config["codecs"])
RESULTS = from_root(config["results"])
DATA_TYPE = config["data_type"]
# Extra d4tools create options, such as --sparse for RNA, as in the D4 paper.
D4TOOLS_OPTIONS = config.get("d4tools_options", "")
EVICT = str(ROOT / "workflows/lib/evict.py")
AGREEMENT = str(ROOT / "workflows/single/agreement.py")
REF_LOCAL = "ref/reference.fa"  # the copy in the working directory
THREADS = config["threads"]  # {tool: [thread counts]}
REPEATS = range(1, config["repeats"] + 1)
TOOLS = ["pbz", "mosdepth", "d4tools", "megadepth"]
# The contig the correctness check compares base by base. Every reference has it.
CHECK_CONTIG = "chr22"
# The scans use the cohort benchmark's timer and BigWig script, in place.
TIMED_TRIALS = str(ROOT / "workflows/create/timed_trials.py")
BIGWIG_SCAN = str(ROOT / "workflows/create/bigwig_scan.py")
CHROM_SIZES = from_root(config["chrom_sizes"])
REGIONS_BED = from_root(config["regions_bed"])
SCAN_TRIALS = config["scan_trials"]
ANALYSES = ["full_scan", "region_scan"]
# Each tool's output is scanned at that tool's thread counts. bigwig_scan.py
# uses that many processes (its --threads).
SCAN_THREADS = THREADS

# Every timed command must really get its thread count.
if workflow.cores < max(max(counts) for counts in THREADS.values()):
    raise ValueError("--cores must be at least the largest thread count in the config")


def alignment(sample):
    return ALIGNMENT.format(sample=sample)


def index(sample):
    return INDEX.format(sample=sample)


# The local reference copy as rule inputs, and a tool's reference option. Both
# are empty without a reference.
REF_INPUTS = [REF_LOCAL, REF_LOCAL + ".fai"] if REFERENCE else []


def ref_option(option):
    return f"{option} {REF_LOCAL}" if REFERENCE else ""


# Pick the samples. Sort the first `first_n` manifest samples by alignment file
# size (ties broken by manifest order) and take the one at each quantile.
with open(MANIFEST) as handle:
    manifest = [row["sample_id"] for row in csv.DictReader(handle, delimiter="\t")]
by_size = sorted(
    (os.stat(alignment(sample)).st_size, order, sample)
    for order, sample in enumerate(islice(manifest, config["first_n"]))
)
picked = [by_size[round(q * (len(by_size) - 1))] for q in config["quantiles"]]
# The size of each picked alignment file. It is the `cram_bytes` column even for
# a BAM, so the rows of every data type line up.
CRAM_BYTES = {sample: size for size, _, sample in picked}

# One result file per run: tool, sample, threads, repeat.
ROWS = [
    f"{RESULTS}/runs/{tool}/{sample}/t{threads}/r{repeat}.tsv"
    for tool in TOOLS
    for sample in CRAM_BYTES
    for threads in THREADS[tool]
    for repeat in REPEATS
]

# A run whose result file already exists is finished, so a rerun after a crash
# skips it. Leave it out of the workflow completely. If it stayed in, the fresh
# copy of the reference would make Snakemake redo it.
TODO = [row for row in ROWS if not os.path.exists(row)]

# One timing file per scan: tool, sample, threads, analysis. Finished scans are
# left out the same way.
SCANS = [
    f"{RESULTS}/scans/{tool}/{sample}/t{threads}/{analysis}.tsv"
    for tool in TOOLS
    for sample in CRAM_BYTES
    for threads in SCAN_THREADS[tool]
    for analysis in ANALYSES
]
SCANS_TODO = [scan for scan in SCANS if not os.path.exists(scan)]

wildcard_constraints:
    sample="[^/]+",
    threads=r"\d+",
    repeat=r"\d+",
    analysis="full_scan|region_scan",
    d4tool="mosdepth|d4tools",


rule all:
    input:
        RESULTS + "/runs.tsv",
        RESULTS + "/samples.tsv",
        RESULTS + "/scans.tsv",
        expand(RESULTS + "/agreement/{sample}.tsv", sample=CRAM_BYTES),


rule samples_table:
    output:
        RESULTS + "/samples.tsv"
    run:
        with open(output[0], "w") as out:
            out.write("sample\tcram_bytes\n")
            for sample, size in CRAM_BYTES.items():
                out.write(f"{sample}\t{size}\n")


# Join all result files, old and new, keeping the header of the first one only.
# The input is the runs still to do, so this waits for them.
rule collect:
    input:
        TODO
    output:
        RESULTS + "/runs.tsv"
    params:
        rows=ROWS
    shell:
        r"""awk 'FNR == 1 && NR != 1 {{ next }} {{ print }}' {params.rows:q} > {output:q}"""


# Copy the reference to the local disk once per job. This is not timed.
if REFERENCE:
    rule stage_reference:
        input:
            fasta=REFERENCE,
            fai=REFERENCE + ".fai"
        output:
            fasta=REF_LOCAL,
            fai=REF_LOCAL + ".fai"
        shell:
            "cp {input.fasta:q} {output.fasta:q} && cp {input.fai:q} {output.fai:q}"


# The four run rules do the same steps. Only the timed command and the output
# differ:
#   1. Drop the alignment file and its index from the page cache, so the read is cold.
#   2. Time the tool. `sync` is inside the timed command, so the time includes
#      flushing the output to disk. Paths have no spaces, so they are not quoted
#      inside sh -c '...'.
#   3. Check that the tool wrote its output. For pbz the store is a folder, so
#      also require a chunk file in its depth/values array. The sizes are put in
#      variables first, so that a failing du or find stops the rule.
#   4. Write the result file: a header and one row.
#   5. Delete the data.

rule run_pbz:
    input:
        alignment=lambda wildcards: alignment(wildcards.sample),
        index=lambda wildcards: index(wildcards.sample),
        ref=REF_INPUTS,
        codecs=CODECS
    output:
        RESULTS + "/runs/pbz/{sample}/t{threads}/r{repeat}.tsv"
    threads: lambda wildcards: int(wildcards.threads)
    resources:
        bench=1
    params:
        evict=EVICT,
        pbz=PBZ,
        reference=ref_option("--reference"),
        data="data/pbz/{sample}/t{threads}/r{repeat}",
        store="data/pbz/{sample}/t{threads}/r{repeat}/{sample}.pbz",
        cram_bytes=lambda wildcards: CRAM_BYTES[wildcards.sample]
    shell:
        r"""
        python {params.evict} {input.alignment} {input.index}
        mkdir -p {params.data}
        /usr/bin/time -f '%e\t%U\t%S\t%M' -o {params.data}/time.txt sh -c '{params.pbz} import bam {input.alignment}:{wildcards.sample} {params.reference} --threads {wildcards.threads} --track depth --codecs @{input.codecs} --no-progress -o {params.store} && sync'
        test -s {params.store}
        chunks=$(find {params.store}/depth/values/c -type f | wc -l)
        test "$chunks" -gt 0
        bytes=$(du -sb {params.store} | cut -f1)
        files=$(find {params.store} -type f | wc -l)
        test "$files" -gt 0
        read wall user sys rss < {params.data}/time.txt
        printf 'tool\tsample\tthreads\trepeat\tcram_bytes\twall_s\tuser_s\tsys_s\tmax_rss_kb\tout_bytes\tout_files\n' > {output:q}
        printf 'pbz\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' {wildcards.sample} {wildcards.threads} {wildcards.repeat} {params.cram_bytes} "$wall" "$user" "$sys" "$rss" "$bytes" "$files" >> {output:q}
        rm -rf {params.data}
        """


rule run_mosdepth:
    input:
        alignment=lambda wildcards: alignment(wildcards.sample),
        index=lambda wildcards: index(wildcards.sample),
        ref=REF_INPUTS
    output:
        RESULTS + "/runs/mosdepth/{sample}/t{threads}/r{repeat}.tsv"
    threads: lambda wildcards: int(wildcards.threads)
    resources:
        bench=1
    params:
        evict=EVICT,
        reference=ref_option("--fasta"),
        data="data/mosdepth/{sample}/t{threads}/r{repeat}",
        prefix="data/mosdepth/{sample}/t{threads}/r{repeat}/{sample}",
        d4="data/mosdepth/{sample}/t{threads}/r{repeat}/{sample}.per-base.d4",
        cram_bytes=lambda wildcards: CRAM_BYTES[wildcards.sample]
    shell:
        r"""
        python {params.evict} {input.alignment} {input.index}
        mkdir -p {params.data}
        /usr/bin/time -f '%e\t%U\t%S\t%M' -o {params.data}/time.txt sh -c 'mosdepth -t {wildcards.threads} {params.reference} --d4 {params.prefix} {input.alignment} && sync'
        test -s {params.d4}
        bytes=$(du -sb {params.d4} | cut -f1)
        files=$(find {params.d4} -type f | wc -l)
        test "$files" -gt 0
        read wall user sys rss < {params.data}/time.txt
        printf 'tool\tsample\tthreads\trepeat\tcram_bytes\twall_s\tuser_s\tsys_s\tmax_rss_kb\tout_bytes\tout_files\n' > {output:q}
        printf 'mosdepth\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' {wildcards.sample} {wildcards.threads} {wildcards.repeat} {params.cram_bytes} "$wall" "$user" "$sys" "$rss" "$bytes" "$files" >> {output:q}
        rm -rf {params.data}
        """


# d4tools create gets the read filters of the other tools: MAPQ 0 and up, and no
# reads with any flag in 1796 (unmapped, secondary, QC fail, duplicate). Its own
# defaults are MAPQ 60 and up and no flag filter. ~1796 is in double quotes so
# the shell does not read ~ as a home directory.
rule run_d4tools:
    input:
        alignment=lambda wildcards: alignment(wildcards.sample),
        index=lambda wildcards: index(wildcards.sample),
        ref=REF_INPUTS
    output:
        RESULTS + "/runs/d4tools/{sample}/t{threads}/r{repeat}.tsv"
    threads: lambda wildcards: int(wildcards.threads)
    resources:
        bench=1
    params:
        evict=EVICT,
        reference=ref_option("-r"),
        options=D4TOOLS_OPTIONS,
        data="data/d4tools/{sample}/t{threads}/r{repeat}",
        d4="data/d4tools/{sample}/t{threads}/r{repeat}/{sample}.d4",
        cram_bytes=lambda wildcards: CRAM_BYTES[wildcards.sample]
    shell:
        r"""
        python {params.evict} {input.alignment} {input.index}
        mkdir -p {params.data}
        /usr/bin/time -f '%e\t%U\t%S\t%M' -o {params.data}/time.txt sh -c 'd4tools create -t {wildcards.threads} {params.reference} -q 0 -F "~1796" {params.options} {input.alignment} {params.d4} && sync'
        test -s {params.d4}
        bytes=$(du -sb {params.d4} | cut -f1)
        files=$(find {params.d4} -type f | wc -l)
        test "$files" -gt 0
        read wall user sys rss < {params.data}/time.txt
        printf 'tool\tsample\tthreads\trepeat\tcram_bytes\twall_s\tuser_s\tsys_s\tmax_rss_kb\tout_bytes\tout_files\n' > {output:q}
        printf 'd4tools\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' {wildcards.sample} {wildcards.threads} {wildcards.repeat} {params.cram_bytes} "$wall" "$user" "$sys" "$rss" "$bytes" "$files" >> {output:q}
        rm -rf {params.data}
        """


rule run_megadepth:
    input:
        alignment=lambda wildcards: alignment(wildcards.sample),
        index=lambda wildcards: index(wildcards.sample),
        ref=REF_INPUTS
    output:
        RESULTS + "/runs/megadepth/{sample}/t{threads}/r{repeat}.tsv"
    threads: lambda wildcards: int(wildcards.threads)
    resources:
        bench=1
    params:
        evict=EVICT,
        reference=ref_option("--fasta"),
        data="data/megadepth/{sample}/t{threads}/r{repeat}",
        prefix="data/megadepth/{sample}/t{threads}/r{repeat}/{sample}",
        bigwig="data/megadepth/{sample}/t{threads}/r{repeat}/{sample}.all.bw",
        cram_bytes=lambda wildcards: CRAM_BYTES[wildcards.sample]
    shell:
        r"""
        python {params.evict} {input.alignment} {input.index}
        mkdir -p {params.data}
        /usr/bin/time -f '%e\t%U\t%S\t%M' -o {params.data}/time.txt sh -c 'megadepth {input.alignment} {params.reference} --bigwig --filter-out 1796 --threads {wildcards.threads} --prefix {params.prefix} && sync'
        test -s {params.bigwig}
        bytes=$(du -sb {params.bigwig} | cut -f1)
        files=$(find {params.bigwig} -type f | wc -l)
        test "$files" -gt 0
        read wall user sys rss < {params.data}/time.txt
        printf 'tool\tsample\tthreads\trepeat\tcram_bytes\twall_s\tuser_s\tsys_s\tmax_rss_kb\tout_bytes\tout_files\n' > {output:q}
        printf 'megadepth\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' {wildcards.sample} {wildcards.threads} {wildcards.repeat} {params.cram_bytes} "$wall" "$user" "$sys" "$rss" "$bytes" "$files" >> {output:q}
        rm -rf {params.data}
        """


# The correctness check. Each tool runs once more, untimed, with the options of
# its timed runs and its largest thread count, and keeps its output until
# agreement.py has compared them. These jobs take bench=1 too, so they never run
# beside a timed run.

rule check_pbz:
    input:
        alignment=lambda wildcards: alignment(wildcards.sample),
        index=lambda wildcards: index(wildcards.sample),
        ref=REF_INPUTS,
        codecs=CODECS
    output:
        temp(directory("check/{sample}/pbz.pbz"))
    threads: max(THREADS["pbz"])
    resources:
        bench=1
    params:
        pbz=PBZ,
        reference=ref_option("--reference")
    shell:
        "{params.pbz} import bam {input.alignment}:{wildcards.sample} {params.reference} --threads {threads}"
        " --track depth --codecs @{input.codecs} --no-progress -o {output}"


rule check_mosdepth:
    input:
        alignment=lambda wildcards: alignment(wildcards.sample),
        index=lambda wildcards: index(wildcards.sample),
        ref=REF_INPUTS
    output:
        temp("check/{sample}/mosdepth.per-base.d4")
    threads: max(THREADS["mosdepth"])
    resources:
        bench=1
    params:
        reference=ref_option("--fasta"),
        prefix="check/{sample}/mosdepth"
    shell:
        "mosdepth -t {threads} {params.reference} --d4 {params.prefix} {input.alignment}"


rule check_d4tools:
    input:
        alignment=lambda wildcards: alignment(wildcards.sample),
        index=lambda wildcards: index(wildcards.sample),
        ref=REF_INPUTS
    output:
        temp("check/{sample}/d4tools.d4")
    threads: max(THREADS["d4tools"])
    resources:
        bench=1
    params:
        reference=ref_option("-r"),
        options=D4TOOLS_OPTIONS
    shell:
        "d4tools create -t {threads} {params.reference} -q 0 -F '~1796' {params.options} {input.alignment} {output}"


rule check_megadepth:
    input:
        alignment=lambda wildcards: alignment(wildcards.sample),
        index=lambda wildcards: index(wildcards.sample),
        ref=REF_INPUTS
    output:
        temp("check/{sample}/megadepth.all.bw")
    threads: max(THREADS["megadepth"])
    resources:
        bench=1
    params:
        reference=ref_option("--fasta"),
        prefix="check/{sample}/megadepth"
    shell:
        "megadepth {input.alignment} {params.reference} --bigwig --filter-out 1796 --threads {threads} --prefix {params.prefix}"


# One row for each pair of tools: how many bases of CHECK_CONTIG they cover and
# how many of those differ in depth.
rule agreement:
    input:
        pbz="check/{sample}/pbz.pbz",
        mosdepth="check/{sample}/mosdepth.per-base.d4",
        d4tools="check/{sample}/d4tools.d4",
        megadepth="check/{sample}/megadepth.all.bw",
        script=AGREEMENT
    output:
        RESULTS + "/agreement/{sample}.tsv"
    resources:
        bench=1
    shell:
        "python {input.script} {DATA_TYPE} {wildcards.sample} {CHECK_CONTIG} {output}"
        " pbz={input.pbz} mosdepth={input.mosdepth} d4tools={input.d4tools} megadepth={input.megadepth}"


# The scans: the same commands as the cohort benchmark's (workflows/cohort), on
# the one-sample outputs of the check runs above. timed_trials.py drops the
# output from the page cache before each of SCAN_TRIALS trials. What a scan
# writes stays in the working directory; only the timing file goes to the
# results folder.

# The whole-genome region list for the full scans: every contig, 0 to its length.
rule full_scan_bed:
    input:
        CHROM_SIZES
    output:
        "full_scan.bed"
    shell:
        r"""awk 'BEGIN {{OFS="\t"}} $2 > 0 {{print $1, 0, $2}}' {input:q} > {output:q}"""


rule scan_pbz:
    input:
        store="check/{sample}/pbz.pbz",
        regions=lambda wc: "full_scan.bed" if wc.analysis == "full_scan" else REGIONS_BED,
        timer=TIMED_TRIALS
    output:
        RESULTS + "/scans/pbz/{sample}/t{threads}/{analysis}.tsv"
    threads: lambda wildcards: int(wildcards.threads)
    resources:
        bench=1
    params:
        pbz=PBZ,
        trials=SCAN_TRIALS,
        out="scan/pbz.{sample}.t{threads}.{analysis}.tsv"
    shell:
        """
        mkdir -p scan
        python {input.timer:q} --data {input.store:q} --cache cold --trials {params.trials} --output {output:q} -- \
            {params.pbz:q} stat {input.store:q} depth -s mean -t {wildcards.threads} -r {input.regions:q} -o {params.out:q}
        """


# mosdepth's and d4tools create's D4 files. --no-index for the full scan, as in
# the cohort benchmark, so d4tools reads the depths and not the index summaries.
rule scan_d4:
    input:
        d4=lambda wc: f"check/{wc.sample}/" + ("mosdepth.per-base.d4" if wc.d4tool == "mosdepth" else "d4tools.d4"),
        regions=lambda wc: "full_scan.bed" if wc.analysis == "full_scan" else REGIONS_BED,
        timer=TIMED_TRIALS
    output:
        RESULTS + "/scans/{d4tool}/{sample}/t{threads}/{analysis}.tsv"
    threads: lambda wildcards: int(wildcards.threads)
    resources:
        bench=1
    params:
        trials=SCAN_TRIALS,
        scan_flag=lambda wc: "--no-index" if wc.analysis == "full_scan" else "",
        out="scan/{d4tool}.{sample}.t{threads}.{analysis}.tsv"
    shell:
        """
        mkdir -p scan
        python {input.timer:q} --data {input.d4:q} --cache cold --trials {params.trials} --output {output:q} -- \
            sh -c 'd4tools stat {params.scan_flag} -s mean -H -t {wildcards.threads} -r {input.regions} {input.d4} > {params.out}'
        """


# The full scan reads whole chromosomes from the file's header, so it gets no BED.
rule scan_bigwig:
    input:
        bigwig="check/{sample}/megadepth.all.bw",
        regions=lambda wc: [] if wc.analysis == "full_scan" else [REGIONS_BED],
        scanner=BIGWIG_SCAN,
        timer=TIMED_TRIALS
    output:
        RESULTS + "/scans/megadepth/{sample}/t{threads}/{analysis}.tsv"
    threads: lambda wildcards: int(wildcards.threads)
    resources:
        bench=1
    params:
        trials=SCAN_TRIALS,
        out="scan/megadepth.{sample}.t{threads}.{analysis}.tsv"
    shell:
        """
        mkdir -p scan
        python {input.timer:q} --data {input.bigwig:q} --cache cold --trials {params.trials} --output {output:q} -- \
            sh -c 'python {input.scanner} -t {wildcards.threads} {input.bigwig} {input.regions} > {params.out}'
        """


# All scan timing files in one table, with the tool, sample, thread count and
# scan in front of each trial row.
rule collect_scans:
    input:
        SCANS_TODO
    output:
        RESULTS + "/scans.tsv"
    params:
        scans=SCANS
    run:
        with open(output[0], "w") as out:
            for number, path in enumerate(params.scans):
                tool, sample, threads, analysis = Path(path).with_suffix("").parts[-4:]
                with open(path) as handle:
                    header, *rows = handle.read().splitlines()
                if number == 0:
                    out.write("tool\tsample\tthreads\tanalysis\t" + header + "\n")
                for row in rows:
                    out.write(f"{tool}\t{sample}\t{threads[1:]}\t{analysis}\t{row}\n")
